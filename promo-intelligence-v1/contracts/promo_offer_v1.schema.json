{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promo_offer_v1",
  "title": "Promo Offer V1",
  "type": "object",
  "required": ["contract", "offer_id", "offer_type", "merchant", "item", "pricing", "validity", "conditions", "verification", "source", "evidence"],
  "properties": {
    "contract": {"const": "promo_offer_v1"},
    "offer_id": {"type": "string", "minLength": 1},
    "offer_type": {"enum": ["price_discount", "special_price", "coupon", "bundle", "other"]},
    "merchant": {
      "type": "object",
      "required": ["name", "branch"],
      "properties": {"name": {"type": ["string", "null"]}, "branch": {"type": ["string", "null"]}}
    },
    "item": {
      "type": "object",
      "required": ["name", "brand", "category"],
      "properties": {"name": {"type": ["string", "null"]}, "brand": {"type": ["string", "null"]}, "category": {"type": ["string", "null"]}}
    },
    "pricing": {
      "type": "object",
      "required": ["currency", "regular_price", "promo_price", "discount_amount", "discount_percent"],
      "properties": {
        "currency": {"type": "string"},
        "regular_price": {"type": ["number", "null"]},
        "promo_price": {"type": ["number", "null"]},
        "discount_amount": {"type": ["number", "null"]},
        "discount_percent": {"type": ["number", "null"]}
      }
    },
    "validity": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {"start": {"type": ["string", "null"]}, "end": {"type": ["string", "null"]}}
    },
    "conditions": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "required": ["verification_state", "freshness_state", "expiry_state", "source_reliability"],
      "properties": {
        "verification_state": {"enum": ["verified", "partial", "unverified", "rejected"]},
        "freshness_state": {"enum": ["fresh", "stale", "unknown"]},
        "expiry_state": {"enum": ["active", "expired", "unknown"]},
        "source_reliability": {"enum": ["high", "medium", "low", "unknown"]}
      }
    },
    "source": {
      "type": "object",
      "required": ["source_id", "source_type", "url", "observed_at"],
      "properties": {
        "source_id": {"type": "string"}, "source_type": {"type": "string"}, "url": {"type": "string"}, "observed_at": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["content_hash", "source_offer_id", "extracted_text"],
      "properties": {
        "content_hash": {"type": "string"}, "source_offer_id": {"type": ["string", "null"]}, "extracted_text": {"type": "string"}
      }
    }
  }
}
